# Test server settings for Docker Compose (deploy/candidate/compose.yaml, docs/releasing.md).
# Copy to .env beside compose.yaml (never commit it), or enter them as the stack's
# environment variables in Portainer. Only these settings reach the test server: email,
# Home Assistant, printers and backups stay off.

# --- Images -----------------------------------------------------------------
# The image the server runs: the previous release while restoring, then the candidate.
ROLLCALL_TAG=1.3.0
# The candidate's image, which restores the backup when RESTORE=1.
CANDIDATE_TAG=1.4.0-rc.1
# 1 replaces the test server's data with the newest live backup, scrubbed, when the stack
# starts. Set it back to 0 before upgrading to the candidate, or the upgrade restores again.
RESTORE=1

# --- Compose ----------------------------------------------------------------
# The port on the server, other than the live server's.
CANDIDATE_PORT=8001
# The live stack's backup volume, read only.
# LIVE_BACKUPS_VOLUME=rollcall-backups

# --- Settings key (required) ------------------------------------------------
# The live server's SETTINGS_KEY (or the contents of its /data/settings.key), so the
# restored Firebase settings and salt can be read.
SETTINGS_KEY=

# --- As on the live server --------------------------------------------------
TRUSTED_NETWORKS=192.168.1.0/24
# FORWARDED_ALLOW_IPS=192.168.1.5
# false to sign in over plain HTTP on the LAN (http://server:8001).
COOKIE_SECURE=false
# TZ=America/Chicago
# CATALOG_SYNC=daily
